rules_version = '2';

// Firebase Storage Security Rules — Threads Post Analyzer
// Paths: pdfs/{userId}/{timestamp}_{filename}
// Deploy: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // PDFs: user can read/write only under their own uid folder
    // Upload: PDF only, max 10MB. Delete: request.resource is null.
    match /pdfs/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource == null
                       || (request.resource.size < 10 * 1024 * 1024
                           && request.resource.contentType.matches('application/pdf')));
    }
  }
}
